# Normalize text files in Git
* text=auto

# Windows scripts/config metadata
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.txt text eol=crlf
*.py text eol=lf
*.pyw text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.exe binary
